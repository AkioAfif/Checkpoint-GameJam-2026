  m_Script: {fileID: 11500000, guid: 2e0ce3e543780b04dba488492949ce28, type: 3}
  m_Name: Sari_First
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lineArray:
  - speaker: 1
    text: Did you see that?! He nearly flattened me!
    playerEmote: 0
    npcEmote: 4
  - speaker: 1
    text: Who drives like that over a bridge? Reckless!
    playerEmote: 0
    npcEmote: 3
  - speaker: 1
    text: Hey! What's that giant tube in front of your house?
    playerEmote: 0
    npcEmote: 5
  - speaker: 0
    text: A Fabricator. A man from the Instansi gave it to me. For free.
    playerEmote: 0
    npcEmote: 0
  - speaker: 1
    text: For free?
    playerEmote: 0
    npcEmote: 13
  - speaker: 1
    text: Nothing's free. Not even my grandmother's advice, and she gives that to everyone.
    playerEmote: 0
    npcEmote: 0
  - speaker: 0
    text: It makes seeds. Good ones. It could pay off the debt, Sari.
    playerEmote: 0
    npcEmote: 0
  - speaker: 1
    text: Then I hope it does.
    playerEmote: 0
    npcEmote: 0
  - speaker: 1
    text: Just read the small print, okay?
    playerEmote: 0
    npcEmote: 14
  - speaker: 0
    text: I'll get back to work now.
    playerEmote: 5
    npcEmote: 0
  reward:
    itemDataSO: {fileID: 0}
    amount: 0
