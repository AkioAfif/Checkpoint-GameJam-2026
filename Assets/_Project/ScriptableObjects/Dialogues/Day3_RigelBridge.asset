%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e0ce3e543780b04dba488492949ce28, type: 3}
  m_Name: Day3_RigelBridge
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lineArray:
  - speaker: 1
    text: Stop right there.
    playerEmote: 0
    npcEmote: 3
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 0
    text: Rigel? You ran off this morning like you'd seen a ghost.
    playerEmote: 13
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: I watched from my fence. Half that forest edge, gone before noon. And now a bridge that wasn't here an hour ago.
    playerEmote: 0
    npcEmote: 13
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: Nobody does that. Not with their hands. Not with a sawit.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 0
    text: Yesterday you said land should be made with your back. Well... it was.
    playerEmote: 14
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: Don't twist it. That was work. This is... something else.
    playerEmote: 0
    npcEmote: 3
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: Ten years the elders have said nobody clears that edge. Not for rice, not for anyone.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 0
    text: Funny. You never cared about those trees before today.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: You don't know what I cared about.
    playerEmote: 0
    npcEmote: 10
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 0
    text: I know exactly what this is. My sawit outsold your rice, and now I've got more land than you.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 0
    text: You're jealous, Rigel. Just say it.
    playerEmote: 14
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: ...Jealous.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: "That ground was supposed to be\u2014"
    playerEmote: 0
    npcEmote: 4
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: Forget it. Enjoy your field while it lasts.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  reward:
    itemDataSO: {fileID: 0}
    amount: 0
