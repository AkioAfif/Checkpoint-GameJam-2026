  m_Script: {fileID: 11500000, guid: 2e0ce3e543780b04dba488492949ce28, type: 3}
  m_Name: Day6_Bill
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lineArray:
  - speaker: 1
    text: Rivers silt up. Soil tires. It all comes back, slowly.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 1
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: Money doesn't come back. You take it when it's offered.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: Lv.3 tonight, and the rest of the forest by the end of the month.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: The damage takes years. The profit takes a week.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
