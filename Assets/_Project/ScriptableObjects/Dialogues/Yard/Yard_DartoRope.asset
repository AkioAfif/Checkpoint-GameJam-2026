  lineArray:
  - speaker: 1
    text: You got it back! Good lad.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
  - speaker: 1
    text: Clearing a stump too? Then take this rope. I built that bridge with it.
    playerEmote: 0
    npcEmote: 2
    isShaking: 0
    isNpcGlaring: 0
  - speaker: 1
    text: A stump's like a stubborn goat. You don't lift it, you drag it.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
