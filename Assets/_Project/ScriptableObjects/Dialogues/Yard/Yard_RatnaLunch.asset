  m_Script: {fileID: 11500000, guid: 2e0ce3e543780b04dba488492949ce28, type: 3}
  m_Name: Yard_RatnaLunch
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lineArray:
  - speaker: 1
    text: There you are! You've been running round the village all morning. Sit. Eat.
    playerEmote: 0
    npcEmote: 5
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: Since my husband's passing, it's just me and Dimas. We get by.
    playerEmote: 0
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 11400000, guid: ec69cc29c19ef9a4da4252de82d35ef2, type: 2}
  - speaker: 1
    text: ICAN pays well, doesn't it? Almost too well...
    playerEmote: 0
    npcEmote: 13
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 1
    text: Here, compost from my garden. New soil is hungry soil.
    playerEmote: 0
    npcEmote: 1
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  - speaker: 0
    text: Thank you, Bu Ratna. I'll make sure to use them.
    playerEmote: 1
    npcEmote: 0
    isShaking: 0
    isNpcGlaring: 0
    focusNpcSO: {fileID: 0}
  reward:
    itemDataSO: {fileID: 11400000, guid: e4609a76591f778478d1bf1c31a77745, type: 2}
    amount: 1
  rewardDay: 0
