  m_Script: {fileID: 11500000, guid: 2e0ce3e543780b04dba488492949ce28, type: 3}
  m_Name: Rigel_First
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lineArray:
  - speaker: 1
    text: Hey, neighbour! Is that sawit? It wasn't there two days ago.
    playerEmote: 0
    npcEmote: 5
  - speaker: 0
    text: It grows fast. Really fast.
    playerEmote: 0
    npcEmote: 0
  - speaker: 1
    text: Ten years I've farmed this soil. Nothing grows that fast.
    playerEmote: 0
    npcEmote: 13
  - speaker: 1
    text: Where'd you get the seeds?
    playerEmote: 0
    npcEmote: 0
  - speaker: 0
    text: ICAN gave me a machine. The Fabricator.
    playerEmote: 0
    npcEmote: 0
  - speaker: 1
    text: A machine that makes seeds. Huh.
    playerEmote: 0
    npcEmote: 3
  - speaker: 1
    text: Tell you what. Let's see who brings in the better harvest this week.
    playerEmote: 0
    npcEmote: 14
  - speaker: 1
    text: Bet you can't grow anything better than that.
    playerEmote: 0
    npcEmote: 0
  - speaker: 0
    text: Watch me.
    playerEmote: 6
    npcEmote: 0
  - speaker: 0
    text: Maybe something from the old forest will do the trick...
    playerEmote: 0
    npcEmote: 0
  reward:
    itemDataSO: {fileID: 0}
    amount: 0
