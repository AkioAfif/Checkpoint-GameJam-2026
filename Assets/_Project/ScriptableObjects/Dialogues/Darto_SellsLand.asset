  m_Script: {fileID: 11500000, guid: 2e0ce3e543780b04dba488492949ce28, type: 3}
  m_Name: Darto_SellsLand
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lineArray:
  - speaker: 1
    text: So you're the one feeding half of ICAN's trucks!
    playerEmote: 0
    npcEmote: 6
  - speaker: 1
    text: That strip by the trees was my father's. My knees can't work it anymore.
    playerEmote: 0
    npcEmote: 0
  - speaker: 0
    text: How much, Pak Darto?
    playerEmote: 0
    npcEmote: 0
  - speaker: 1
    text: For you? Four million, and you keep the village proud.
    playerEmote: 0
    npcEmote: 1
  - speaker: 0
    text: Deal.
    playerEmote: 6
    npcEmote: 0
  - speaker: 1
    text: Just stop where the old trees start. That forest was here before any of us.
    playerEmote: 0
    npcEmote: 0
  reward:
    itemDataSO: {fileID: 0}
    amount: 0
